# Optional CoinGecko demo key. Measured without one: the public tier 429s above ~5/min
# and answers Retry-After ~70s, so config.yaml ships api.coingecko.com at 5/min.
# With a demo key you can safely raise that to ~30/min.
COINGECKO_API_KEY=
# Strongly recommended: unauthenticated GitHub is 60 req/hr, a token gives 5000 req/hr.
# Needs no scopes for public repos.
GITHUB_TOKEN=
